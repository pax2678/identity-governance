// Prisma Schema for IGA Core Data Model
// PostgreSQL with Apache AGE graph extension per research.md Decision #2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

